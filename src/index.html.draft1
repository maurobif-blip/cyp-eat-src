function openComments(db) { return (db.comments || []).filter(function (c) { return !c.done; }).sort(function (a, b) { return a.at < b.at ? 1 : -1; }); }
function commentLine(c) { return (c.byName || '') + ' · ' + c.screen + ' · ' + localTime(c.at); }
function commentsCard(db) {
  var open = openComments(db), done = (db.comments || []).length - open.length;
  var list = (S.showDone ? (db.comments || []).slice().sort(function (a, b) { return a.at < b.at ? 1 : -1; }) : open);
  return '<div class="card" style="gap:0"><span class="b" style="font-size:18px;padding-bottom:6px">Comments on the app' + (open.length ? ' (' + open.length + ' to do)' : '') + '</span>' +
    (open.length ? '<button class="btn" data-a="copyComments" style="margin-bottom:8px">Copy the ' + plural(open.length, 'comment', 'comments') + ' to do</button>' : '') +
    (list.length ? list.map(function (c) {
      return '<div class="row" style="flex-direction:column;align-items:stretch;gap:4px"><span class="m s">' + esc(commentLine(c)) + '</span><span' + (c.done ? ' class="m"' : '') + '>' + esc(c.text) + '</span><button class="nc' + (c.done ? ' on' : '') + '" data-a="cdone" data-id="' + esc(c.id) + '" style="align-self:flex-start">' + (c.done ? 'Done · open again' : 'Done') + '</button></div>';
    }).join('') : '<span class="m">' + (done ? 'Nothing to do.' : 'None yet.') + '</span>') +
