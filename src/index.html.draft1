      }
    }
    if ((e.type === 'before' || e.type === 'skip') && !seen[e.centre + e.date + e.meal]) {
      seen[e.centre + e.date + e.meal] = 1;
      var u = eatMealUse(db, e.centre, e.date, e.meal), b = eatGet(db, 'before', e.centre, e.date, e.meal), a = eatGet(db, 'after', e.centre, e.date, e.meal), mn = eatMenuOf(db, e.centre, e.date, e.meal);
      var menuTxt = menuText(db, mn, e.meal);
      if (u.skipped) { food.rows.push([e.date, WD[eatWeekday(e.date)], c, e.meal, menuTxt, '', '', '', '', '', '', u.plates, '', '', 'Yes']); return; }
      if (!b) return;
      for (var id in b.data.q) {
        var it = id === 'pcs' ? { name: 'Chicken pieces', use: 'pieces' } : eatItem(db, id), per = id === 'pcs' ? null : eatPerPlate(u, id);
        var used = id === 'pcs' ? u.pieces : u.used[id];
        if (id === 'pcs' && u.pieces != null && u.hasAfter && u.base) per = u.pieces / u.base;
        food.rows.push([e.date, WD[eatWeekday(e.date)], c, e.meal, menuTxt, it.name, b.data.q[id] == null ? 'Not counted' : b.data.q[id], a ? (a.data.q[id] == null ? (a.data.nc && a.data.nc[id] ? 'Not counted' : '') : a.data.q[id]) : 'Not yet', id === 'pcs' ? 'pieces' : (rowUnit(it, (b.data.u || {})[id]) === 'unit' ? it.unit : it.use), used == null ? '' : used, it.use, u.plates, u.kept, per == null ? '' : (it.use === 'kg' ? Math.round(per * 1000) + ' g' : Math.round(per * 100) / 100), '']);
      }
    }
    if (e.type === 'received') for (var r in e.data.q) if (e.data.q[r] != null && eatItem(db, r)) rec.rows.push(['', e.date, WD[eatWeekday(e.date)], c, eatItem(db, r).name, e.data.q[r], eatItem(db, r).unit, '', '', 'Old screen: food delivered', '', e.byName]);
    if (e.type === 'note' && !e.data.off) {
      /* the note's own centre gets what is left after the parts for other places; each part is a row for its place */
      var own = eatNoteQ(e, e.centre), noteRow = function (place, q, remark) { for (var r2 in q) if (q[r2] != null && eatItem(db, r2)) rec.rows.push([Number(e.data.no), e.date, WD[eatWeekday(e.date)], place, eatItem(db, r2).name, q[r2], eatItem(db, r2).unit, e.data.days ? e.data.days : '', eatNoteUntil(e), remark, e.data.recv, e.byName]); };
      noteRow(c, own, e.data.remark);
      (e.data.parts || []).forEach(function (pt) { noteRow(pt.name, pt.q, 'Part of the note for ' + c); });
    }
    if (e.type === 'endweek' || e.type === 'startweek') { var st = eatStock(db, e.centre, e.date, e.type === 'startweek'); for (var k in e.data.q) { var x = st[k], cnt = e.data.q[k]; if (!eatItem(db, k)) continue; end.rows.push([e.date, WD[eatWeekday(e.date)], c, e.type === 'startweek' ? 'Start of the week' : 'End of the week', eatItem(db, k).name, x ? x.expected : '', cnt == null ? 'Not counted' : cnt, cnt != null && x && x.expected != null ? Math.round((cnt - x.expected) * 100) / 100 : '', eatItem(db, k).unit, e.byName]); } }
  });
  var stock = { name: 'In the store now', head: ['Centre', 'Item', 'Last count', 'Date of the count', 'Delivered since', 'Used since', 'Now (expected)', 'Unit'], rows: [] };
  eatCanteens(db).forEach(function (c) { var st = eatStock(db, c.id, todayStr()); db.items.forEach(function (it) { var s = st[it.id]; if (s) stock.rows.push([c.name, it.name, s.start, s.startDate || '', s.inn, s.used, s.expected, it.unit]); }); });
  /* the store week by week, from the first week with data: expected next to counted */
  var chk = { name: 'Store check by week', head: ['Week from', 'Week to', 'Centre', 'Item', 'Unit', 'Start', 'Delivered', 'Cooked', 'Expected', 'Counted', 'Difference', 'Start from the count of', 'End counted on', 'Days with a daily count', 'Days'], rows: [] };
  var firstW = E.length ? eatMonday(E[0].date) : eatMonday(todayStr());
  for (var wk = firstW, g = 0; wk <= eatMonday(todayStr()) && g < 120; wk = eatAddDays(wk, 7), g++) eatCanteens(db).forEach(function (c) {
    var w = eatWeekCheck(db, c.id, wk, todayStr());
    db.items.forEach(function (it) { var x = w.items[it.id]; if (!x || (!x.start && !x.inn && !x.used && !x.counted)) return; chk.rows.push([wk, eatAddDays(wk, 6), c.name, it.name, it.unit, x.start == null ? '' : x.start, x.inn, x.used, x.expected == null ? '' : x.expected, x.counted === undefined ? 'Not yet' : (x.counted === null ? 'Not counted' : x.counted), x.diff == null ? '' : x.diff, w.startDate, w.endDate, w.daysFood, w.days]); });
  });
  people.rows.sort(function (a, b) { var ka = a[0] + a[2] + EAT_MEALS.indexOf(a[3]), kb = b[0] + b[2] + EAT_MEALS.indexOf(b[3]); return ka < kb ? -1 : (ka > kb ? 1 : 0); });
  var com = { name: 'Comments', head: ['Time', 'Who', 'Screen', 'Comment', 'Done'], rows: (db.comments || []).map(function (c) { return [localTime(c.at), c.byName, c.screen, c.text, c.done ? 'Done' : '']; }) };
  saveFile('CYP-EAT_' + todayStr() + '.xlsx', makeXlsx([people, day].concat(food.rows.length ? [food] : []).concat([rec, end, chk, stock, com])));
}

/* ===================== events ===================== */
document.addEventListener('click', function (ev) {
  var el = ev.target.closest('[data-a]'); if (!el || el.disabled) return;
  var a = el.getAttribute('data-a'); if (A[a]) { ev.preventDefault(); A[a](el); }
});
document.addEventListener('input', function (ev) {
  var el = ev.target;
  if (el.hasAttribute('data-f')) S.f[el.getAttribute('data-f')] = el.value;
  if (el.hasAttribute('data-mv')) S.f.meals[el.getAttribute('data-mv')][el.getAttribute('data-k')] = el.value;
  if (el.hasAttribute('data-q')) { var k = el.getAttribute('data-q'); if (k === 'kept') S.f.kept = el.value; else S.f.q[k] = el.value; liveUpdate(); }
});
function keepInputs() {
  var k = document.createElement('div'); k.id = 'keep'; k.style.display = 'none';
  k.innerHTML = '<input id="cam" type="file" accept="image/*" capture="environment"><input id="gal" type="file" accept="image/*">';
  document.body.appendChild(k);
  ['cam', 'gal'].forEach(function (id) { document.getElementById(id).addEventListener('change', function () { if (S.sess && S.scr === 'deliver') A.photo(this); else this.value = ''; }); });
}
keepInputs();
document.addEventListener('change', function (ev) { var el = ev.target; if (el.hasAttribute && el.hasAttribute('data-a-change') && A[el.getAttribute('data-a-change')]) A[el.getAttribute('data-a-change')](el); });
window.addEventListener('online', function () { S.online = true; sync(); bgRender(); });
window.addEventListener('offline', function () { S.online = false; bgRender(); });
if (WIDE.addEventListener) WIDE.addEventListener('change', function () { bgRender(); }); else if (WIDE.addListener) WIDE.addListener(function () { bgRender(); });
window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); S.installEvt = e; KV.set('installed', false); if (S.modal === installModal) drawModal(); else bgRender(); setTimeout(installAsk, 1500); });
window.addEventListener('appinstalled', function () { S.installEvt = null; KV.set('installed', true); if (S.modal === installModal) closeModal(); bgRender(); });
setInterval(function () { if (S.sess && document.visibilityState === 'visible') sync(); }, 30000);
document.addEventListener('visibilitychange', function () {
  if (document.visibilityState === 'hidden') { peopleFlush(); S.hiddenAt = Date.now(); return; }
  if (!S.sess) return;
  var away = S.hiddenAt ? Date.now() - S.hiddenAt : 0; S.hiddenAt = 0;
  /* back after 30 minutes: the day is asked again; from the count of the people (saved by itself) the centre too */
  newDay(); if (away > 30 * 60000 && S.dayOk && S.sess.mode === 'entry') { askDay(true); if (S.scr === 'people') { peopleFlush(); S.afterCentre = 'people'; S.scr = 'centre'; } bgRender(); }
  sync();
});
window.addEventListener('pagehide', function () { peopleFlush(); });
/* the app left open overnight, with or without internet: the next day starts on the new date */
function newDay() {
  var t = todayStr(); if (!S.today) S.today = t;
  if (t === S.today) return;
  var wasToday = S.date === S.today; S.today = t;
  askDay(true);
  if (wasToday) { peopleFlush(); S.date = t; S.week = eatMonday(t); S.pick = t; S.calM = t.slice(0, 8) + '01'; fixMeal(); enter(S.scr); render(); }
  else bgRender();
}
setInterval(function () { if (S.sess) newDay(); }, 60000);


function boot() {
  readLink();
  if ('serviceWorker' in navigator && location.protocol === 'https:') { try { navigator.serviceWorker.register('sw.js').catch(function () {}); } catch (e) {} }
  if (!S.cfg) { S.scr = 'nolink'; return render(); }
  if (S.sess) { startSession(); hello(); return; }
  S.scr = 'signin'; render();
  hello().then(function (res) { if (res && res.empty) { S.scr = 'setup'; S.f = {}; } render(); });
}
boot();
</script>
</body>
</html>
