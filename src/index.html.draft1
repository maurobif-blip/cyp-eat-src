  else prompt('Copy the comments', text);
};
A.cdone = function (el) { var c = eatFind(view().comments, el.getAttribute('data-id')); queue({ kind: 'comment_done', cid: c.id, done: !c.done }); S.keepScroll = true; render(); };
A.comment = function () { S.f.ct = ''; openModal(commentModal); };
A.modalClose = function () { S.msg = ''; closeModal(); };
A.commentSave = function () {
  var t = (S.f.ct || '').trim(); if (!t) return;
  var who = S.sess.mode === 'admin' ? ((S.f.cn || KV.get('cname', '') || 'Overview').trim()) : S.sess.name;
