A.go = function (el) { go(el.getAttribute('data-to')); };
A.hideNotice = function () { S.notice = ''; render(); };
function openWithLink(text) {
  var cfg = parseLink(text);
  if (!cfg) { S.msg = 'This is not the CYP EAT link. Copy the whole link from the message.'; return render(); }
  useLink(cfg); S.msg = ''; S.f = {}; readLink(); S.scr = 'signin'; render();
  hello().then(function (res) { if (res && res.empty) { S.scr = 'setup'; S.f = {}; } render(); });
}
A.linkOpen = function () { openWithLink(S.f.lk); };
A.linkClip = function () { navigator.clipboard.readText().then(function (t) { S.f.lk = t; openWithLink(t); }, function () { S.msg = 'The phone did not let CYP EAT read the copied link. Paste it in the box.'; render(); }); };
A.install = function () { if (!S.installEvt) return; var ev = S.installEvt; ev.prompt(); S.installEvt = null; if (S.modal) closeModal(); ev.userChoice.then(function (r) { if (r && r.outcome === 'accepted') KV.set('installed', true); render(); }, function () {}); };
A.installNo = function () { KV.set('installNo', true); if (S.modal) closeModal(); render(); };
A.installOpen = function () { S.instAuto = false; openModal(installModal); };
A.setupSave = function () {
  var f = S.f, ok = function (p) { return /^\d{4}$/.test(p || ''); };
  if (!ok(f.p1) || !ok(f.p3)) { S.msg = 'Each PIN: 4 numbers.'; return render(); }
  if (f.p1 !== f.p2 || f.p3 !== f.p4) { S.msg = 'The two PINs written twice are not the same.'; return render(); }
  if (f.p1 === f.p3) { S.msg = 'The two PINs must be different.'; return render(); }
  var es = uid() + uid(), as = uid() + uid();
  S.busy = true; render();
  post({ action: 'setup', entry: { salt: es, cred: credOf(es, f.p1) }, admin: { salt: as, cred: credOf(as, f.p3) } }).then(function (res) {
    S.busy = false;
    if (!res || !res.ok) { S.msg = res && res.error === 'not_empty' ? 'The PINs are already set.' : 'Not saved. Try again.'; return render(); }
    return hello().then(function () { S.f = {}; S.msg = ''; S.good = 'PINs saved. Now sign in with the overview PIN and add the names.'; S.scr = 'signin'; render(); });
  }).catch(function () { S.busy = false; S.msg = 'No internet. The first use needs internet.'; render(); });
};
A.mode = function (el) { S.pinMode = el.getAttribute('data-m'); S.pin = ''; S.msg = ''; S.scr = 'pin'; render(); };
A.key = function (el) {
  var k = el.getAttribute('data-k');
  if (k === 'del') { S.pin = S.pin.slice(0, -1); S.msg = ''; return render(); }
  if (k !== 'ok') { if (S.pin.length >= 4) return; S.pin += k; S.msg = ''; return render(); }
  if (S.pin.length !== 4) return;
  var mode = S.pinMode, st = (view().settings || {})[mode];
  if (!st || !st.salt) { S.msg = mode === 'delivery' && view().settings && view().settings.entry ? 'The overview has not set the deliveries PIN yet.' : 'Open CYP EAT once with internet.'; return render(); }
  var cred = credOf(st.salt, S.pin), pin = S.pin;
  function enterAs() { S.verif[mode] = sha256('v:' + cred); KV.set('verif', S.verif); S.sess = { mode: mode, cred: cred, nid: '', name: mode === 'delivery' ? 'Deliveries' : '', centre: '' }; KV.set('sess', S.sess); S.pin = ''; S.good = ''; startSession(); }
  S.busy = true; render();
  post({ action: 'login', mode: mode, cred: cred }).then(function (res) {
    S.busy = false; S.online = true;
    if (res && res.ok) return enterAs();
    S.pin = ''; S.msg = res && res.error === 'locked' ? 'Too many wrong PINs. Wait one minute.' : 'Wrong PIN. Try again.'; render();
  }).catch(function () {
    S.busy = false; S.online = false;
    if (S.verif[mode] && S.verif[mode] === sha256('v:' + cred)) return enterAs();
    S.pin = ''; S.msg = S.verif[mode] ? 'Wrong PIN. Try again.' : 'No internet. The first time on this phone needs internet.'; render();
  });
};
function remember() { KV.set('sess', S.sess); KV.set('me', { nid: S.sess.nid, name: S.sess.name, centre: S.sess.centre }); }
A.pickName = function (el) { var n = eatFind(view().names, el.getAttribute('data-id')); S.sess.nid = n.id; S.sess.name = n.name; S.sess.centre = ''; KV.set('sess', S.sess); S.scr = 'centre'; render(); };
A.pickCentre = function (el) { S.sess.centre = el.getAttribute('data-id'); remember(); S.meal = defaultMeal(); var to = S.afterCentre || 'today'; S.afterCentre = ''; go(to); };
A.who = function () { peopleFlush(); S.afterCentre = ''; S.scr = 'name'; render(); };
A.signout = function () { signOut(''); };
A.centreAsk = function () { peopleFlush(); S.afterCentre = S.scr === 'people' ? 'people' : 'today'; S.scr = 'centre'; S.f = {}; render(); };
A.dayAsk = function () { peopleFlush(); askDay(true); render(); };
A.calDay = function (el) { var d = el.getAttribute('data-d'); if (!eatIsDate(d) || d > todayStr()) return; S.pick = d; S.keepScroll = true; render(); };
A.calMonth = function (el) { var y = Number(S.calM.slice(0, 4)), m = Number(S.calM.slice(5, 7)) - 1 + Number(el.getAttribute('data-d')); var dt = new Date(Date.UTC(y, m, 1)).toISOString().slice(0, 8) + '01'; if (dt > todayStr()) return; S.calM = dt; S.keepScroll = true; render(); };
A.calToday = function () { S.pick = todayStr(); S.calM = S.pick.slice(0, 8) + '01'; S.keepScroll = true; render(); };
A.dayConfirm = function () {
  var d = S.pick || todayStr(); S.dayOk = true;
  /* the same day: what the person was writing stays; another day: its numbers are read */
  if (d !== S.date) { peopleFlush(); S.date = d; S.week = eatMonday(d); fixMeal(); enter(S.scr); }
  render();
};
A.day = function (el) { peopleFlush(); var d = Number(el.getAttribute('data-d')); S.date = d === 0 ? todayStr() : eatAddDays(S.date, d); if (S.date > todayStr()) S.date = todayStr(); fixMeal(); enter(S.scr); render(); };
function fixMeal() { if (countMeals().indexOf(S.meal) < 0) S.meal = defaultMeal(); }
A.meal = function (el) { peopleFlush(); S.meal = el.getAttribute('data-m'); enter(S.scr); S.keepScroll = true; render(); };
/* people: every change is kept on the phone at once and saved 1.5 seconds after the last tap (or on leaving the screen) */
function peopleChanged(inc) {
  var wasSkip = S.f.skip || S.f.askSkip;
  S.f.done = false; S.f.skip = false; S.f.askSkip = false; /* a change after Finish, or after "not counted", opens the count again */
  if (inc) S.f.hist.push({ g: S.f.grp || '', k: inc });
  var d = pData(), dr = KV.get('draft', {}); dr[draftKey()] = d; KV.set('draft', dr);
  S.pPend = { d: S.date, m: S.meal, data: d, k: draftKey() };
  clearTimeout(S.pTimer); S.pTimer = setTimeout(peopleFlush, 1500);
  var c = document.getElementById('cnt'), st = document.getElementById('pst');
  if (c) c.textContent = curCount(); if (st) st.innerHTML = peopleStatus();
  var sb = document.querySelector('[data-a="grp"][aria-pressed="true"] .num'); if (sb) sb.textContent = curCount();
  var tb = document.querySelector('.tap'); if (tb) { tb.classList.remove('s-none', 's-done', 's-skip'); tb.classList.add('s-count'); }
  var md = document.querySelector('[data-a="meal"][aria-pressed="true"] .sd'); if (md) md.className = 'sd s-count';
  if (wasSkip) { S.keepScroll = true; render(); } /* the boxes of "not counted" go away */
}
function peopleFlush() {
  clearTimeout(S.pTimer); S.pTimer = null;
  var p = S.pPend; if (!p || !S.sess) return; S.pPend = null;
  var saved = eatGet(view(), 'people', S.sess.centre, p.d, p.m);
  if (!samePeople(saved, p.data)) saveEntry('people', p.m, p.data, p.d);
  var dr = KV.get('draft', {}); delete dr[p.k]; KV.set('draft', dr);
  if (S.scr === 'people') bgRender();
}
function ringTap() { var b = document.querySelector('.tap'); if (!b) return; b.classList.remove('hit'); void b.offsetWidth; b.classList.add('hit'); }
A.less = function () { if (curCount() < 1) return; S.f.hist = []; setCount(curCount() - 1); peopleChanged(0); S.keepScroll = true; render(); };
A.tap = function () { vibrate(); ringTap(); setCount(curCount() + 1); peopleChanged(1); };
A.grp = function (el) { S.f.grp = el.getAttribute('data-g'); S.keepScroll = true; render(); };
A.add = function (el) { var k = Number(el.getAttribute('data-n')); vibrate(); ringTap(); setCount(curCount() + k); peopleChanged(k); };
A.noCount = function () {
  if (eatPlates({ data: pData() }) > 0 && !S.f.askSkip) { S.f.askSkip = true; S.keepScroll = true; return render(); }
  S.f.skip = true; S.f.done = false; S.f.askSkip = false; S.f.n = 0; for (var k in S.f.g) S.f.g[k] = 0; S.f.hist = [];
  S.pPend = { d: S.date, m: S.meal, data: pData(), k: draftKey() }; peopleFlush(); render();
};
A.noCountNo = function () { S.f.askSkip = false; S.keepScroll = true; render(); };
A.finish = function () {
  S.f.done = true; S.pPend = { d: S.date, m: S.meal, data: pData(), k: draftKey() }; peopleFlush();
  /* where the leftovers are counted, they come next, once every meal to count is finished (Mauro, 20/11) */
  var db = view(), c = S.sess.centre, allDone = countMeals().every(function (m) { var p = eatGet(db, 'people', c, S.date, m); return p && p.data.done; });
  if (eatLeft(db, c) && allDone) { var line = S.meal + ' is finished: ' + peopleLine(pData()) + '. Now the leftovers.'; go('after'); S.good = line; return render(); }
  S.keepScroll = true; render();
};
A.adding = function () { S.f.adding = !S.f.adding; S.f.an = ''; S.keepScroll = true; render(); };
A.addOk = function () { var k = Math.round(Number(S.f.an)); if (isFinite(k) && k > 0 && k < 2000) { setCount(curCount() + k); S.f.adding = false; peopleChanged(k); } S.keepScroll = true; render(); };
A.undo = function () { var h = S.f.hist.length ? S.f.hist.pop() : { g: S.f.grp || '', k: 1 }; var keep = S.f.grp; S.f.grp = h.g; setCount(Math.max(0, curCount() - h.k)); peopleChanged(0); S.f.grp = keep; S.keepScroll = true; render(); };
A.typing = function () { S.f.typing = true; S.keepScroll = true; render(); };
A.typeOk = function () { var n = Math.round(Number(S.f.tn)); if (isFinite(n) && n >= 0) { S.f.hist = []; setCount(n); peopleChanged(0); } S.f.typing = false; S.keepScroll = true; render(); };
A.stepSkip = function (el) { var st = el.getAttribute('data-s'); if (!SKIPTXT[st]) return; setStepSkip(st, true); S.notice = ''; go('today'); S.good = SKIPTXT[st][1] + ' on ' + dayName(S.date) + '. It can still be added later.'; render(); };
A.skip = function (el) { saveEntry('dskip', '', { on: el.getAttribute('data-on') === '1' }); S.keepScroll = true; render(); };
A.bfm = function (el) { var x = S.f.meals.Breakfast, v = el.getAttribute('data-v'); x.mm = v === 'mm'; x.isOther = v === 'other'; S.keepScroll = true; render(); };
A.cook = function (el) { var n = el.getAttribute('data-n'); S.f.cook = S.f.cook === n ? '' : n; S.keepScroll = true; render(); };
A.mmm = function (el) { var x = S.f.meals[el.getAttribute('data-m')]; x.mm = !x.mm; S.keepScroll = true; render(); };
A.rel = function (el) { var x = S.f.meals[el.getAttribute('data-m')], id = el.getAttribute('data-id'), i = x.relish.indexOf(id); if (i >= 0) x.relish.splice(i, 1); else x.relish.push(id); S.keepScroll = true; render(); };
A.addRow = function (el) { var id = el.getAttribute('data-id'), it = eatItem(view(), id); if (S.f.rows.indexOf(id) < 0) S.f.rows.push(id); if (it && it.unit !== it.use) S.f.u[id] = 'unit'; S.keepScroll = true; render(); };
A.mm = function () { S.f.mm = !S.f.mm; S.keepScroll = true; render(); };
A.relish = function (el) { var id = el.getAttribute('data-id'), i = S.f.relish.indexOf(id); if (i >= 0) S.f.relish.splice(i, 1); else S.f.relish.push(id); S.keepScroll = true; render(); };
A.bf = function (el) { var v = el.getAttribute('data-v'); S.f.mm = v === 'mm'; S.f.bread = v === 'bread'; S.keepScroll = true; render(); };
A.saveMenu = function () {
  var ms = {}, f = S.f;
  for (var m in f.meals) {
    var x = f.meals[m];
    if (m === 'Breakfast') {
      var other = x.isOther ? (x.other || '').trim() : '';
      if (x.isOther && !other) { S.notice = 'Breakfast: write what it is, or choose porridge.'; return render(); }
      ms[m] = { mm: !!x.mm, other: other };
    } else ms[m] = { mm: !!x.mm, relish: x.relish.slice(), veg: (x.veg || '').trim() };
  }
  /* dinner is not asked: it is the same as lunch */
  if (ms.Lunch && ms.Dinner) ms.Dinner = { mm: ms.Lunch.mm, relish: ms.Lunch.relish.slice(), veg: ms.Lunch.veg };
  saveEntry('dmenu', '', { meals: ms, cook: (f.cook || '').trim() }); setStepSkip('menu', false); go('before');
};
A.unit = function (el) { var k = el.getAttribute('data-k'); S.f.u[k] = el.getAttribute('data-v'); S.keepScroll = true; render(); };
A.nc = function (el) {
  var k = el.getAttribute('data-k');
  if (k === 'kept') S.f.keptNc = !S.f.keptNc; else S.f.nc[k] = !S.f.nc[k];
  S.keepScroll = true; render();
};
/* ¼ ½ ¾: the whole number written, and that part; .0: the whole number only */
A.frac = function (el) {
  var k = el.getAttribute('data-k'), v = Number(el.getAttribute('data-v')), cur = eatNum(S.f.q[k]) || 0;
  var nv = Math.floor(cur) + v; S.f.q[k] = nv;
  var inp = document.getElementById('q_' + k); if (inp) inp.value = nv;
  liveUpdate();
};
A.step = function (el) {
  var k = el.getAttribute('data-k'), s = Number(el.getAttribute('data-s'));
  var cur = k === 'kept' ? eatNum(S.f.kept) : eatNum(S.f.q[k]);
  var nv = Math.max(0, Math.round(((cur || 0) + s) * 1000) / 1000);
  if (k === 'kept') S.f.kept = nv; else S.f.q[k] = nv;
  var inp = document.getElementById('q_' + k); if (inp) inp.value = nv;
  liveUpdate();
};
function liveUpdate() {
  var bal = document.getElementById('bal'); if (bal && S.scr === 'after') bal.innerHTML = balanceHtml();
  if (S.scr === 'endweek' || S.scr === 'startweek') { var st = eatStock(view(), S.sess.centre, S.f.date, S.scr === 'startweek'); view().items.forEach(function (it) { var box = document.getElementById('d_' + it.id); if (box && st[it.id]) box.innerHTML = endPill(it, st[it.id]); }); }
}
function qData() { var q = {}, nc = {}; for (var k in S.f.q) q[k] = eatNum(S.f.q[k]); for (k in S.f.nc) if (S.f.nc[k]) { nc[k] = true; q[k] = null; } return { q: q, nc: nc }; }
function missingRows() {
  var miss = [];
  S.f.rows.forEach(function (id) { if (!S.f.nc[id] && eatNum(S.f.q[id]) == null) miss.push(eatItem(view(), id).name); });
  if (S.f.rows.indexOf('chk') >= 0 && !S.f.nc.pcs && eatNum(S.f.q.pcs) == null) miss.push('Chicken pieces');
  return miss;
}
A.saveBefore = function () {
  var miss = missingRows();
  if (miss.length) { S.notice = 'Write a number or tap Not counted: ' + miss.join(', ') + '.'; return render(); }
  var d = qData(); S.f.rows.forEach(function (id) { if (!(id in d.q)) d.q[id] = null; });
  if (S.f.rows.indexOf('chk') >= 0 && !('pcs' in d.q)) d.q.pcs = null;
  d.u = S.f.u || {};
  var toPeople = peopleOpen(); saveEntry('dbefore', '', d); setStepSkip('before', false); S.notice = ''; go(toPeople ? 'people' : 'today');
};
A.saveAfter = function () {
  var d = qData(); S.f.rows.forEach(function (id) { if (!(id in d.q) || d.q[id] == null) d.q[id] = S.f.nc[id] ? null : (eatNum(S.f.q[id]) || 0); });
  if (S.f.rows.indexOf('chk') >= 0 && !S.f.nc.pcs && d.q.pcs == null) d.q.pcs = 0;
  d.u = S.f.u || {};
  saveEntry('dafter', '', d); setStepSkip('after', false); go('today');
};
function queueNote(centre, date, data) { queue({ kind: 'entry', e: { type: 'note', centre: centre, date: date, meal: '', data: data, by: S.sess.nid || '', byName: myName() || 'Overview', at: nowIso() } }); }
A.noteNew = function () { S.noteNo = ''; go('note'); };
A.noteOpen = function (el) { S.noteNo = el.getAttribute('data-no'); go('note'); };
A.partAdd = function () {
  var db = view(), f = S.f, to = (document.getElementById('pto') || {}).value, id = (document.getElementById('pit') || {}).value, n = eatNum((document.getElementById('pqt') || {}).value), it = eatItem(db, id), have = eatNum(f.q[id]) || 0;
  if (!to || !it || !n) { S.notice = 'Choose the place and the food, and write the quantity of the part.'; return render(); }
  if (n > have) { S.notice = 'The note has ' + fmt(have) + ' ' + it.unit + ' of ' + it.name.toLowerCase() + ': the part cannot be more.'; return render(); }
  var q = {}; q[id] = n; f.parts = (f.parts || []).concat([{ to: to, name: centreName(to), q: q }]); S.notice = ''; S.keepScroll = true; render();
};
A.partOff = function (el) { S.f.parts.splice(Number(el.getAttribute('data-i')), 1); S.keepScroll = true; render(); };
A.noteCentre = function (el) { S.f.centre = el.getAttribute('data-id'); S.keepScroll = true; render(); };
A.noteSave = function () {
  var f = S.f, db = view(), no = eatNoteNo(f.no), q = {}, any = false;
  if (!no) { S.notice = 'Write the note number: the red number on the note.'; return render(); }
  if (!eatIsDate(f.date) || f.date > todayStr()) { S.notice = 'Check the date: it cannot be after today.'; return render(); }
  var dl = S.sess.mode === 'delivery';
  if (!eatCentre(db, f.centre)) { S.notice = 'Choose who the note is for.'; return render(); }
  for (var k in f.q) { var n = eatNum(f.q[k]); if (n != null && n > 0) { q[k] = n; any = true; } }
  if (!any) { S.notice = 'Write at least one quantity.'; return render(); }
  if (!dl && !f.days && !f.daysOk) { f.daysOk = true; S.notice = 'How long should this delivery last? Choose the days, or press Save again to leave it empty.'; return render(); }
  var other = eatNote(db, no);
  if (other && no !== f.orig && f.dupOk !== no) { f.dupOk = no; S.notice = 'Note ' + no + ' is already saved (' + centreName(other.centre) + ', ' + dayName(other.date) + '). Press Save again to replace it.'; return render(); }
  /* a new number for the same paper note: the old number is removed */
  if (f.orig && f.orig !== no) { var old = eatNote(db, f.orig); if (old) queueNote(old.centre, old.date, { no: old.data.no, q: old.data.q, days: old.data.days, remark: old.data.remark, recv: old.data.recv, off: true }); }
  queueNote(f.centre, f.date, { no: no, q: q, parts: (f.parts || []).filter(function (pt) { return pt.to !== f.centre; }), days: f.days || null, remark: (f.remark || '').trim(), recv: (f.recv || '').trim(), photo: f.photo || '' });
  if (dl) {
    /* back to the photos: the next note of the same picture, or the thank you */
    var v = S.dvBack; S.dvBack = null;
    if (v && v.reads) { v.saved.push(no); if (v.i + 1 < v.reads.length) { v.i++; v.sentence = readSentence(view(), v.reads[v.i]); S.dv = v; } else S.dv = { step: 'saved', nos: v.saved, unclear: v.unclear }; }
    else S.dv = { step: 'saved', nos: [no], unclear: 0 };
    return go('deliver');
  }
  S.week = eatMonday(f.date); go('deliveries'); S.good = 'Note ' + no + ' saved.'; render();
};
A.noteOff = function () {
  if (!S.f.offAsk) { S.f.offAsk = true; S.keepScroll = true; return render(); }
  var old = eatNote(view(), S.f.orig);
  if (old) queueNote(old.centre, old.date, { no: old.data.no, q: old.data.q, days: old.data.days, remark: old.data.remark, recv: old.data.recv, off: true });
  var no = S.f.orig; if (S.sess.mode === 'delivery') { S.dv = { step: 'start' }; go('deliver'); } else go('deliveries'); S.good = 'Note ' + no + ' removed.'; render();
};
A.saveCount = function () {
  var db = view(), f = S.f, miss = db.items.filter(function (it) { return it.stock && !f.nc[it.id] && eatNum(f.q[it.id]) == null; }).map(function (it) { return it.name; });
  if (miss.length) { S.notice = 'Write a number or tap Not counted: ' + miss.join(', ') + '.'; return render(); }
  saveEntry(f.kind, '', qData(), f.date); S.notice = ''; go('week');
  S.good = (f.kind === 'startweek' ? 'Start of the week' : 'End of the week') + ' saved, ' + dayName(f.date) + '.'; render();
};
A.countDay = function (el) { S.f.date = el.getAttribute('data-d'); S.keepScroll = true; render(); };
