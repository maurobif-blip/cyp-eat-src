    if (res && res.ok) { S.reader = !!res.reader; S.f.rk = ''; S.good = 'Key saved. The photo reader is on.'; } else S.notice = 'Not saved. Try again.';
    S.keepScroll = true; render();
  }).catch(function () { S.notice = 'Saving the key needs internet.'; render(); });
};
