A.dvOpen = function (el) { S.dvBack = null; S.notePre = null; S.noteNo = el.getAttribute('data-no'); go('note'); };
A.dvYes = function () {
  var v = S.dv, r = v.reads[v.i];
  queueNote(r.centre, r.date, { no: r.no, q: r.q, parts: r.parts || [], days: null, remark: r.remark || '', recv: r.recv || '', photo: v.photo || '' });
