A.saveUnits = function () {
  var db = view(), n = 0, miss = [];
  db.items.forEach(function (it) {
    var un = S.f['un_' + it.id] || it.unit, pack = un !== it.use, raw = S.f['pe_' + it.id], per = pack ? (raw != null ? eatNum(raw) : (it.unit === un ? it.per : null)) : 1;
    if (pack && !per) { per = 0; miss.push(it.name.toLowerCase()); }
    if (un !== it.unit || (pack && per !== it.per)) { queue({ kind: 'item_unit', iid: it.id, unit: un, per: per }); n++; }
    delete S.f['un_' + it.id]; delete S.f['pe_' + it.id];
