A.grpOff = function (el) { var c = eatCentre(view(), el.getAttribute('data-id')), g = el.getAttribute('data-g'); if (!confirm('Remove ' + g + ' from ' + c.name + '?')) return; queue({ kind: 'centre_groups', cid: c.id, groups: (c.groups || []).filter(function (x) { return x !== g; }) }); S.keepScroll = true; render(); };
A.fixSave = function (el) {
  var c = eatCentre(view(), el.getAttribute('data-id')), m = el.getAttribute('data-m'), k = 'fx_' + c.id + '_' + m, raw = S.f[k] != null ? String(S.f[k]).trim() : String((c.fixed || {})[m] || ''), n = raw === '' ? 0 : Math.round(Number(raw));
