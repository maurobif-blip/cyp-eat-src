A.placeAdd = function () { var n = (S.f.np || '').trim(); if (!n) return; queue({ kind: 'place_add', name: n }); S.f.np = ''; S.keepScroll = true; render(); };
A.placeOff = function (el) { var c = eatCentre(view(), el.getAttribute('data-id')); if (!c || !confirm('Remove ' + c.name + '?')) return; queue({ kind: 'place_off', cid: c.id }); S.keepScroll = true; render(); };
